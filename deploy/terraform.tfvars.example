# Copy this file to terraform.tfvars and fill in your values.

subscription_id = "00000000-0000-0000-0000-000000000000"

app_name    = "tfavmagent"
environment = "dev"
location    = "swedencentral"

# Container image settings
# image_name is just the repo path inside ACR, no registry prefix
image_name     = "tf-avm-agent-web"
api_image_name = "tf-avm-agent-api"
image_tag      = "latest"

# Compute sizing — Web frontend
container_cpu    = 0.25
container_memory = "0.5Gi"

# Compute sizing — API backend
api_container_cpu    = 0.5
api_container_memory = "1Gi"

# Scaling
min_replicas = 1
max_replicas = 3

# Optional additional tags
tags = {
  owner   = "platform-team"
  project = "tf-avm-agent"
}

# Azure OpenAI settings
openai_deployment_name = "gpt-4o"
openai_model_name      = "gpt-4o"
openai_model_version   = "2024-11-20"
openai_capacity        = 30 # 30K tokens-per-minute
